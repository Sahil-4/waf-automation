{
  "name": "waf-automation",
  "version": "0.1.0",
  "description": "Web Automation Framework — general-purpose browser step executor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "waf": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "playwright",
    "browser-automation",
    "cli",
    "yaml",
    "web-scraping",
    "automation"
  ],
  "author": "Sahil-4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahil-4/waf-automation.git"
  },
  "homepage": "https://github.com/sahil-4/waf-automation#readme",
  "bugs": {
    "url": "https://github.com/sahil-4/waf-automation/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.3.1",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
